/// Originated loans with balance, rate and days-past-due. Grain: one loan. Source of lending and delinquency measures.
table fact_loan
	lineageTag: 81d1a368-7b32-5dcb-a826-47afff98a397

	/// Loan identifier. Grain of this table.
	column loanId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 7bf14ff5-4410-562e-b309-654e6b9bd931
		summarizeBy: none
		sourceColumn: loanId

	/// Lending source borrower ID (lineage); use customerKey for joins.
	column borrowerId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 1632b3d1-6a13-52dd-87c8-ee3becd73c5a
		summarizeBy: none
		sourceColumn: borrowerId

	/// Originating loan application.
	column applicationId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 36c4f834-31e9-5046-9afb-32ecb7776e50
		summarizeBy: none
		sourceColumn: applicationId

	/// Original loan principal in USD.
	column principal
		dataType: double
		sourceProviderType: float
		lineageTag: 5b351114-082c-581b-8967-c68b7d5516ec
		summarizeBy: none
		sourceColumn: principal

	/// Annual interest rate percent. Not additive; average, do not sum.
	column rate
		dataType: double
		sourceProviderType: float
		lineageTag: f73fd951-43cc-5ebc-b49f-645e70c05bdc
		summarizeBy: none
		sourceColumn: rate

	/// Loan term in months. Not additive.
	column termMonths
		dataType: int64
		sourceProviderType: bigint
		lineageTag: ee8473af-8012-59d5-a5e4-0cb7b9061aa1
		summarizeBy: none
		sourceColumn: termMonths

	/// Outstanding loan balance in USD. Summed by Loan Book Balance.
	column balance
		dataType: double
		sourceProviderType: float
		lineageTag: 4d2ad407-b79c-5bd9-916b-74b272c54a6d
		summarizeBy: none
		sourceColumn: balance

	/// Days past due; 30+ counts as delinquent.
	column dpd
		dataType: int64
		sourceProviderType: bigint
		lineageTag: b44ba0f9-4609-5b0b-a5dc-f8cc47ec3735
		summarizeBy: none
		sourceColumn: dpd

	/// Date the loan was originated.
	column originationDate
		dataType: dateTime
		sourceProviderType: datetime2
		lineageTag: 763efe76-d7cf-5eae-8c67-32255b6911ba
		summarizeBy: none
		sourceColumn: originationDate

	/// Master customer key; the join to Customer.
	column customerKey
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 5e0985fa-13ef-56a5-96e4-8f1f65ef32ff
		summarizeBy: none
		sourceColumn: customerKey

	/// Total outstanding loan balance in USD.
	measure 'Loan Book Balance' = SUM(fact_loan[balance])
		displayFolder: Lending
		lineageTag: 15efc74a-5824-53f4-8c53-04f1c43ebfaf

	/// Average loan interest rate percent.
	measure 'Avg Loan Rate' = AVERAGE(fact_loan[rate])
		displayFolder: Lending
		lineageTag: 2042f6d1-b9c5-5cfe-8cca-ed5df4988657

	/// Share of loans 30+ days past due. A lower rate is better.
	measure 'Delinquency Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_loan), fact_loan[dpd] >= 30), COUNTROWS(fact_loan))
		displayFolder: Lending
		lineageTag: 4f92f855-7367-50dc-ad45-610926b3a16a

	/// Net interest margin across loans and deposits. Higher is better.
	measure 'Net Interest Margin' = DIVIDE(SUMX(fact_loan, fact_loan[balance] * fact_loan[rate] / 100) - [Deposit Balance] * 0.01, [Loan Book Balance] + [Deposit Balance])
		displayFolder: Lending
		lineageTag: 3458a12b-5e49-51c4-8c0b-8cfceea6acf3

	partition fact_loan = entity
		mode: directLake
		source
			entityName: fact_loan
			schemaName: gold
			expressionSource: DatabaseQuery
