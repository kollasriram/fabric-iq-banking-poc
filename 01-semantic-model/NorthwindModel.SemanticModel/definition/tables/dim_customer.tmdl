/// Master customer, entity-resolved across the payments and lending systems. One row per person; join facts on customerKey.
table dim_customer
	lineageTag: e2dff828-3c24-5293-9302-670019f4944b

	/// Master customer key from entity resolution; the join key across payments, lending and fraud. Use this, not source IDs.
	column customerKey
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: e88e5ecc-5afb-50a0-b3ad-47f162185ca3
		summarizeBy: none
		sourceColumn: customerKey

	/// Customer email; the identity attribute used to unify payments and lending records.
	column email
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: c37c68ed-0ab5-5303-b6c7-867283f84e82
		summarizeBy: none
		sourceColumn: email

	/// Customer full name. Default label for the customer.
	column name
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 8b61bbea-7f84-5770-b5e6-c14f1ddfd1b0
		summarizeBy: none
		isDefaultLabel
		sourceColumn: name

	/// Customer segment (e.g., Retail, Wealth, SMB).
	column segment
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 5dde9c87-6e2c-5046-90cb-8b32abd8a731
		summarizeBy: none
		sourceColumn: segment

	/// Customer region for geographic analysis.
	column region
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 88ad0da0-a727-599b-8251-aae5de712c72
		summarizeBy: none
		sourceColumn: region

	/// Customer home country; compared against transaction geo for cross-border fraud.
	column homeCountry
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 13c68694-cba9-5d64-8424-a58f50faf2a8
		summarizeBy: none
		sourceColumn: homeCountry

	/// Model risk score 0-1; higher is riskier. Average, do not sum.
	column riskScore
		dataType: double
		sourceProviderType: float
		lineageTag: e0e1baa1-d541-5bae-86f2-6b84683f4d75
		summarizeBy: none
		sourceColumn: riskScore

	/// Source ID in the payments system (P-*). Lineage only; do not join facts on this.
	column paymentsCustomerId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 6b11bc6d-acfc-5e02-a02f-dfdb63ebd5f8
		summarizeBy: none
		sourceColumn: paymentsCustomerId

	/// Source ID in the lending system (B-*). Lineage only; do not join facts on this.
	column borrowerId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 8f39c22f-8f7c-53a7-a18d-96cc64dc1c54
		summarizeBy: none
		sourceColumn: borrowerId

	/// True if the customer holds a deposit account (present in payments).
	column hasDeposits
		dataType: boolean
		sourceProviderType: bit
		lineageTag: acad9153-c5f7-577b-b1a1-1fc68dd085e9
		summarizeBy: none
		sourceColumn: hasDeposits

	/// True if the customer is a borrower (present in lending).
	column hasLoans
		dataType: boolean
		sourceProviderType: bit
		lineageTag: c0be10df-3907-59d4-9707-bebe60055088
		summarizeBy: none
		sourceColumn: hasLoans

	partition dim_customer = entity
		mode: directLake
		source
			entityName: dim_customer
			schemaName: gold
			expressionSource: DatabaseQuery
