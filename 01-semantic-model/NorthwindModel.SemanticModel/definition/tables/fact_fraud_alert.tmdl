/// Fraud alerts raised on transactions. Grain: one alert. Source of fraud counts and customer fraud exposure.
table fact_fraud_alert
	lineageTag: 7a6e2f35-2efe-533b-85dc-bdd77a1fc9ad

	/// Fraud alert identifier. Grain of this table.
	column alertId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 21105693-80c3-54b4-af12-cae986e86cfd
		summarizeBy: none
		sourceColumn: alertId

	/// Transaction that triggered the alert.
	column txnId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 8029d13c-796a-5f8b-b6b7-8cb468672b0f
		summarizeBy: none
		sourceColumn: txnId

	/// Card involved in the alert.
	column cardId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 262d3e6d-c66b-5ab1-a107-08feed01b5bf
		summarizeBy: none
		sourceColumn: cardId

	/// Payments source customer ID (lineage).
	column customerId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 188d63f2-e234-5440-b990-c52c00c786eb
		summarizeBy: none
		sourceColumn: customerId

	/// Alert type/category.
	column type
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: b258f70d-ede0-585d-b4f4-0e44ecabcd24
		summarizeBy: none
		sourceColumn: type

	/// Alert severity (e.g., Low, Medium, High).
	column severity
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 27197181-b442-51c5-9c59-e74544893c06
		summarizeBy: none
		sourceColumn: severity

	/// Alert status; 'Open' counts toward Open Fraud Alerts.
	column status
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 995a5455-4ab6-5a6e-90a0-0b289d57f3a4
		summarizeBy: none
		sourceColumn: status

	/// Date-time the alert was raised.
	column raisedAt
		dataType: dateTime
		sourceProviderType: datetime2
		lineageTag: 5469bb6e-bcde-532f-af7b-9d593a107ee7
		summarizeBy: none
		sourceColumn: raisedAt

	/// Master customer key; the join to Customer.
	column customerKey
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: f1a91c42-5a09-56e4-a759-3cdd120f91d1
		summarizeBy: none
		sourceColumn: customerKey

	/// Count of fraud alerts currently in Open status.
	measure 'Open Fraud Alerts' = CALCULATE(COUNTROWS(fact_fraud_alert), fact_fraud_alert[status] = "Open")
		displayFolder: Fraud
		lineageTag: b3c159a2-de18-5474-8d5d-9d8d0496782c

	/// Distinct customers with at least one fraud alert.
	measure 'Customers With Fraud Alert' = DISTINCTCOUNT(fact_fraud_alert[customerKey])
		displayFolder: Fraud
		lineageTag: 991b44b7-6ea0-55d6-81fa-8af11de08679

	partition fact_fraud_alert = entity
		mode: directLake
		source
			entityName: fact_fraud_alert
			schemaName: gold
			expressionSource: DatabaseQuery
