/// Merchant/acquirer where card transactions occur. Includes MCC and a risk flag for fraud analysis.
table dim_merchant
	lineageTag: ee2781f5-cb8a-5fc1-922d-8688de7efd94

	/// Merchant key; join to transactions.
	column merchantId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 5195d030-d688-5391-953f-ebf1f7b77b13
		summarizeBy: none
		sourceColumn: merchantId

	/// Merchant name. Default label for the merchant.
	column name
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 706ab036-4026-5e1b-8399-ddae46987f54
		summarizeBy: none
		isDefaultLabel
		sourceColumn: name

	/// Merchant category description.
	column category
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: fff1fdbb-92ef-5bc3-b1dc-945d89086d81
		summarizeBy: none
		sourceColumn: category

	/// Merchant Category Code (numeric). Not additive; do not sum.
	column mcc
		dataType: int64
		sourceProviderType: bigint
		lineageTag: e4fefee4-0133-521d-9914-6817a86d3288
		summarizeBy: none
		sourceColumn: mcc

	/// Merchant country.
	column country
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 8b87c90f-4109-5b24-86e8-24068b6939eb
		summarizeBy: none
		sourceColumn: country

	/// 1 if the merchant is flagged high-risk, else 0. Not additive.
	column riskFlag
		dataType: int64
		sourceProviderType: bigint
		lineageTag: 6bc80ea4-8a78-5d31-b163-833974ae686c
		summarizeBy: none
		sourceColumn: riskFlag

	partition dim_merchant = entity
		mode: directLake
		source
			entityName: dim_merchant
			schemaName: gold
			expressionSource: DatabaseQuery
