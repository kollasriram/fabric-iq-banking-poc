/// Delinquency events flagged on loans (past-due milestones). Grain: one event per loan bucket.
table fact_delinquency
	lineageTag: 846d057d-fa82-5445-b1f1-7e4c5b4d45f0

	/// Loan the delinquency event belongs to.
	column loanId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 3b442121-6e64-5464-89a8-a3781ffd11dc
		summarizeBy: none
		sourceColumn: loanId

	/// Delinquency event identifier. Grain of this table.
	column eventId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: f7cd01b3-7906-5cfc-8bc2-ecbf70518164
		summarizeBy: none
		sourceColumn: eventId

	/// Days-past-due bucket (e.g., 30, 60, 90).
	column dpdBucket
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 1867c5e7-033e-58db-b8de-65d4ef049486
		summarizeBy: none
		sourceColumn: dpdBucket

	/// Date-time the delinquency was flagged.
	column flaggedAt
		dataType: dateTime
		sourceProviderType: datetime2
		lineageTag: 99c57ed5-0756-58ff-981c-57210835d118
		summarizeBy: none
		sourceColumn: flaggedAt

	/// Lending source borrower ID (lineage).
	column borrowerId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 6dd5068a-fd54-5285-9af1-4c0d46e1386a
		summarizeBy: none
		sourceColumn: borrowerId

	/// Master customer key; the join to Customer.
	column customerKey
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: e4df1754-7bf9-5b2d-9ea9-d9d15312d394
		summarizeBy: none
		sourceColumn: customerKey

	partition fact_delinquency = entity
		mode: directLake
		source
			entityName: fact_delinquency
			schemaName: gold
			expressionSource: DatabaseQuery
