/// Calendar date dimension for time intelligence. Join facts on dateKey.
table dim_date
	lineageTag: 17f9c201-c3c6-51ca-abfe-b8ef306babcc

	/// Calendar date. Default label for the date.
	column date
		dataType: dateTime
		sourceProviderType: datetime2
		lineageTag: 2d043282-eb61-5b32-a594-143d3a5d9936
		summarizeBy: none
		isDefaultLabel
		sourceColumn: date

	/// Calendar year. Not additive; do not sum.
	column year
		dataType: int64
		sourceProviderType: bigint
		lineageTag: 3bfc51a2-22e7-54d4-882e-3d073e8adfd0
		summarizeBy: none
		sourceColumn: year

	/// Quarter number 1-4. Not additive.
	column quarter
		dataType: int64
		sourceProviderType: bigint
		lineageTag: 56a4dd63-f296-5bf6-a2db-0c9215c6c39d
		summarizeBy: none
		sourceColumn: quarter

	/// Month number 1-12. Not additive.
	column month
		dataType: int64
		sourceProviderType: bigint
		lineageTag: 8fd6dc46-c8e7-5f8c-9edf-8f3d91bda9c5
		summarizeBy: none
		sourceColumn: month

	/// Day of month. Not additive.
	column day
		dataType: int64
		sourceProviderType: bigint
		lineageTag: efaf50c2-c512-5a4d-8700-c85ef19ddeae
		summarizeBy: none
		sourceColumn: day

	/// Integer yyyymmdd surrogate key; join facts on this.
	column dateKey
		dataType: int64
		sourceProviderType: bigint
		lineageTag: f1f1ead2-b8d3-5b75-b4eb-1aaead39f963
		summarizeBy: none
		sourceColumn: dateKey

	hierarchy Calendar
		lineageTag: cac8ea55-a931-558a-8743-11b4ac1468b7
		level Year
			lineageTag: 95cd9e57-69d5-59c2-902a-6824415daa09
			column: year
		level Quarter
			lineageTag: 8d499a2d-0b86-537c-b5f1-77ca8eebc310
			column: quarter
		level Month
			lineageTag: 8126e19e-6fba-50e5-9c9e-57b2b5fb9f86
			column: month

	partition dim_date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: gold
			expressionSource: DatabaseQuery
