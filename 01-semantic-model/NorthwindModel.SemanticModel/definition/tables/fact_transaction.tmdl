/// Card transactions. Grain: one row per transaction. Source of volume, spend and fraud measures.
table fact_transaction
	lineageTag: 718a7e5d-e096-5bef-8876-0c0e05c6b4ad

	/// Transaction identifier. Grain of this table.
	column txnId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: a62b16ee-c131-50bf-9768-94215ca4d002
		summarizeBy: none
		sourceColumn: txnId

	/// Card used for the transaction.
	column cardId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 8405e3ca-d368-5c31-8f2a-4e1eee585a96
		summarizeBy: none
		sourceColumn: cardId

	/// Account funding the transaction; join to Account.
	column accountId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 885825b2-ecc0-5412-9ea5-786b1232e58d
		summarizeBy: none
		sourceColumn: accountId

	/// Payments source customer ID (lineage); use customerKey for joins.
	column customerId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 6223f0b5-6755-5f35-aeda-16f51c82359d
		summarizeBy: none
		sourceColumn: customerId

	/// Merchant of the transaction; join to Merchant.
	column merchantId
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 1289fb7c-25c4-5f9b-a39f-d002fd102776
		summarizeBy: none
		sourceColumn: merchantId

	/// Transaction amount in USD. Summed by Transaction Amount.
	column amount
		dataType: double
		sourceProviderType: float
		lineageTag: cf3540ab-66c0-5921-bdd8-adbbfca60257
		summarizeBy: none
		sourceColumn: amount

	/// ISO currency code of the transaction.
	column currency
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 0f1a9d47-0728-541e-a699-ad5b614a9ae8
		summarizeBy: none
		sourceColumn: currency

	/// Transaction date-time.
	column timestamp
		dataType: dateTime
		sourceProviderType: datetime2
		lineageTag: 48b01ab5-0d99-5dc1-8787-dd77d7f61fef
		summarizeBy: none
		sourceColumn: timestamp

	/// Channel (e.g., POS, Online, ATM).
	column channel
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 71ca2c03-f79e-58a4-af07-db3bcc73b2d4
		summarizeBy: none
		sourceColumn: channel

	/// Country where the transaction occurred; compared to home country for cross-border fraud.
	column geoCountry
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 0b5d2b35-d36a-57e9-bba1-7925be0ffa04
		summarizeBy: none
		sourceColumn: geoCountry

	/// Merchant Category Code (numeric). Not additive.
	column mcc
		dataType: int64
		sourceProviderType: bigint
		lineageTag: 3b989e7a-4477-5e48-aa35-64a42f73d509
		summarizeBy: none
		sourceColumn: mcc

	/// True if the transaction is confirmed fraud. Drives fraud measures.
	column isFraud
		dataType: boolean
		sourceProviderType: bit
		lineageTag: a1706bfb-0ca5-545a-8fb0-c50ef6bbcad9
		summarizeBy: none
		sourceColumn: isFraud

	/// Fraud pattern label when isFraud is true (e.g., cross-border, velocity).
	column fraudType
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 3b71c94a-8703-5164-8d20-611b85155704
		summarizeBy: none
		sourceColumn: fraudType

	/// Master customer key; the join to Customer.
	column customerKey
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: fc3016c1-2334-525a-b35b-fae3f946f2fc
		summarizeBy: none
		sourceColumn: customerKey

	/// Integer yyyymmdd; join to Date.
	column dateKey
		dataType: int64
		sourceProviderType: bigint
		lineageTag: 5cf70da8-9184-5c19-b99b-471a18ccc6bc
		summarizeBy: none
		sourceColumn: dateKey

	/// Number of card transactions. Base volume metric.
	measure 'Transaction Count' = COUNTROWS(fact_transaction)
		displayFolder: Volumes
		lineageTag: 38b20782-3fe9-5759-a823-39d570e63f4b

	/// Total transaction spend in USD.
	measure 'Transaction Amount' = SUM(fact_transaction[amount])
		displayFolder: Volumes
		lineageTag: 65b70d74-6b76-5096-a704-664dec9f3f08

	/// Count of confirmed-fraud transactions.
	measure 'Fraud Txn Count' = CALCULATE(COUNTROWS(fact_transaction), fact_transaction[isFraud] = TRUE())
		displayFolder: Fraud
		lineageTag: 1083853c-59ca-537b-bf3d-e93d8783f69e

	/// USD amount of confirmed-fraud transactions.
	measure 'Fraud Loss Amount' = CALCULATE(SUM(fact_transaction[amount]), fact_transaction[isFraud] = TRUE())
		displayFolder: Fraud
		lineageTag: 0f1f9166-50d4-5815-b0c4-9c063cd2ff02

	/// Fraud Loss Amount / Transaction Amount. A lower rate is better.
	measure 'Fraud Loss Rate' = DIVIDE([Fraud Loss Amount], [Transaction Amount])
		displayFolder: Fraud
		lineageTag: e811ef5b-f88e-54cd-beb6-d03818ba8038

	/// Estimated fee income at 1.5% of transaction amount.
	measure 'Fee Income' = SUM(fact_transaction[amount]) * 0.015
		displayFolder: Volumes
		lineageTag: 63738441-6b9e-5c32-9132-76a744edb3aa

	partition fact_transaction = entity
		mode: directLake
		source
			entityName: fact_transaction
			schemaName: gold
			expressionSource: DatabaseQuery
